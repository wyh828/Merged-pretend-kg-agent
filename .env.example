# ===== 本机项目路径（相对路径以 F:/Predictive agents 为根，不依赖启动目录）=====
# DATA_DIR=Data/Datasets/technology_trends_01
# OUTPUT_DIR=output/runs/research_01
# LOG_DIR=logs
# CACHE_DIR=data/cache
# LOG_LEVEL=INFO

# ===== Neo4j（P1 起用）=====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# 填入本机 Neo4j 密码，不提交真实值
NEO4J_PASSWORD=
# NEO4J_DATABASE=neo4j
# PROJECT_STORAGE_ROOT=F:/Predictive agents
# NEO4J_IMAGE=neo4j:5.26-community
# 使用 Attempt/env/compose_01.yaml；本机 .env 的镜像已锁定到实际摘要。

# ===== OpenAlex 采集（P1 起用）=====
# OPENALEX_MAILTO=you@example.com        # 进 polite pool（可选）
# OPENALEX_API_KEY=                      # premium key（可选，额度 10×）
# OPENALEX_FROM_DATE=2023-01-01          # 首次无游标时的增量种子
# OPENALEX_CONCEPT_IDS=C154945302,C41008148   # 逗号分隔（AI/CS）
# OPENALEX_MAX_WORKS=1000
# OPENALEX_PER_PAGE=200
# EXTRACT_MAX_CONCEPTS=5
# EXTRACT_MAX_REFS=10

# ===== 预测（RotatE / Kleinberg，P1 起用）=====
# ROTATE_EMBEDDING_DIM=128
# ROTATE_EPOCHS=50
# ROTATE_TRAIN_RATIO=0.8
# BURST_BIN=month
# BURST_S=2.0
# BURST_GAMMA=1.0
# BURST_FUTURE_MONTHS=6
# BURST_TOP_K=10

# ===== 时序预测（P3，无新增密钥；TKG 外推 / 规则 / 回归 / 融合）=====
# PREDICT_ENABLE_TKG=true
# TKG_RELATION=relates_to
# TKG_DOC_TYPES=Paper,Patent,Repo
# TKG_MAX_TIME=              # 留空 = 自动过滤今天之后的未来坏数据；填日期 = 用该日期
# TKG_MIN_COOCCUR=2
# TKG_MAX_ENTITIES=5000
# TKG_TRAIN_RATIO=0.7
# TKG_VAL_RATIO=0.1
# TKG_EMBEDDING_DIM=128
# TKG_EPOCHS=30
# TKG_NEG_SAMPLES=10
# TKG_ALPHA=0.5
# ===== 定向技术关系（P3.5 优化）=====
# TECHPAIR_ENABLE=true
# TECHPAIR_RELATIONS=uses,improves,compares,targets,competes
# TECHPAIR_MIN_SUPPORT=1        # 定向边跨文档重复罕见，默认 1 保边（可调高降噪）
# TECHPAIR_OPENALEX_MAX_DOCS=1000  # OpenAlex works 定向对抽取上限（有摘要才抽；时态跨度来源）
# TKG_EDGE_SOURCE=cooccur         # cooccur=共现投影（正式主边源）| directed=定向 tech→tech（消融对照）；专利引用图经 P2-1 证伪，不再作 TKG 边源
# TKG_SEQUENCE_GENERATE=false
# TKG_GRU_HIDDEN=64
# ===== 专利前向引用图（P0-1，免 key）=====
# PATENT_CITATION_SOURCE=uspto_local   # uspto_local=本地 XML 抽取 | patentsview=bulk 下载（S3 已退役）| bigquery=解析导出 CSV | odp=USPTO Open Data Portal（需 API key）
# PATENT_CITATION_MAX_EDGES=2000000    # 本地 XML 抽取后向引用对上限
# PATENT_CITATIONS_FILE=data/interim/patent_citations.jsonl
# ODP_API_KEY=                         # 全量引文时态（2015→2026）需走 ODP：注册 data.uspto.gov/myodp → ID.me → data.uspto.gov/apis/getting-started
# TLOGIC_MIN_SUPPORT=3   # 定向图 800 事实下 support≥3 即视为反复出现的模式
# TLOGIC_MIN_CONFIDENCE=0.05  # 定向关系天然低于对称共现（~1.0），0.05 为方向性蕴含合理下限
# TLOGIC_MAX_LEN=3
# FORECAST_HORIZON=6
# FORECAST_MIN_HISTORY=12
# FORECAST_TOP_K=100
# FORECAST_LAG=6
# FUSION_WEIGHTS=burst=0.3,tkg=0.4,forecast=0.3
# FUSION_TOP_K=10

# ===== 验证体系（P4：walk-forward 回测 + purge/embargo 防泄漏）=====
# EVAL_ENABLE=true
# EVAL_N_SPLITS=5
# EVAL_TEST_MONTHS=1
# EVAL_STEP_MONTHS=1
# EVAL_EMBARGO_MONTHS=1
# EVAL_PURGE_MONTHS=6
# EVAL_MODE=expanding             # expanding | rolling
# EVAL_ROLLING_WINDOW_MONTHS=24
# EVAL_MIN_TRAIN=200

# ===== 数据源 key（全部可选，按 PROJECT_PLAN.md 2.4 申请指引自行填写）=====
# GITHUB_TOKEN=
# USPTO_API_KEY=
# EPO_OPS_KEY=
# SEMANTIC_SCHOLAR_KEY=

# ===== 多源采集开关（P2，逗号分隔；去掉某源即跳过）=====
# COLLECT_SOURCES=openalex,arxiv,uspto,gdelt,github,rsshub

# ===== arXiv（OAI-PMH / Atom）=====
# ARXIV_FROM_DATE=2023-01-01
# ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.CV
# ARXIV_MAX_RECORDS=500

# ===== USPTO（本地 bulk XML，已存 data/raw，无需 key）=====
# USPTO_RAW_DIR=data/raw
# USPTO_GRANT_GLOB=ipgb*/ipgb*.xml
# USPTO_APP_GLOB=ipab*/ipab*.xml
# USPTO_CPC_PREFIX=G06N
# USPTO_MAX_RECORDS=200
# USPTO_KEEP_WEEKS=4

# ===== GDELT（GKG）=====
# GDELT_FROM_DATE=2023-01-01
# GDELT_MAX_RECORDS=500
# GDELT_THEME_FILTER=TECH_AUTOMATION,TECH_SUPERCOMPUTING,TECH_VIRTUALREALITY,SOC_EMERGINGTECH,SOC_TECHNOLOGYSECTOR,WB_133_INFORMATION_AND_COMMUNICATION_TECHNOLOGIES,WB_669_SOFTWARE_INFRASTRUCTURE,WB_665_SOFTWARE_AS_A_SERVICE,WB_676_CLOUD_COMPUTING,WB_2381_SOFTWARE_DEVELOPMENT,WB_2399_ICT_INNOVATION_AND_TRANSFORMATION,WB_376_INNOVATION_TECHNOLOGY_AND_ENTREPRENEURSHIP,CYBER_ATTACK

# ===== GitHub（Search API）=====
# GITHUB_FROM_DATE=2023-01-01
# GITHUB_MIN_STARS=50
# GITHUB_MAX_REPOS=200
# GITHUB_TOPICS=machine-learning,deep-learning,llm,artificial-intelligence

# ===== RSSHub 中文新闻（P2 新增，Docker 起 RSSHub）=====
# RSSHUB_BASE_URL=http://localhost:1200
# RSSHUB_ROUTES=/36kr/newsflashes,/cnbeta
# RSSHUB_MAX_ITEMS=200

# ===== LLM 抽取（P2 起用，DeepSeek；LLM_API_KEY 在 platform.deepseek.com 申请）=====
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_MAX_TOKENS=2048
# LLM_BATCH_SIZE=20
# LLM_MAX_DOCS_PER_RUN=500
# LLM_TEMPERATURE=0.0

# ===== 实体对齐（P2）=====
# ALIGN_NAME_THRESHOLD=0.90
# ALIGN_ENABLE_LLM=false

# ===== 编排与自动化（P5，全部默认关，无 key 也跑通）=====
# ===== 双轨调度：hermes-agent cron（主）/ APScheduler（降级），入口统一 cron.py =====
# SCHEDULE_ENABLE=false            # 启用内置 APScheduler 调度（hermes-agent 接管时关）
# SCHEDULE_CRON=0 3 * * *          # 每日 03:00 本地（避免整点）
# SCHEDULE_TIMEZONE=Asia/Shanghai

# ===== 每日运行（runbook）=====
# DAILY_MODE=incremental           # incremental(增量,默认) | full(全量，不短路下游)
# DAILY_SKIP_IF_NO_NEW=true        # 全源 0 新增 → 短路下游，写 no-op stamp
# RUN_MANIFEST_FILE=output/run_manifest.jsonl

# ===== 报告推送（notify，第 8 阶段；cron 无人值守开 true）=====
# NOTIFY_ENABLE=false
# NOTIFY_CHANNELS=file             # 逗号分隔：file,telegram,discord
# NOTIFY_TELEGRAM_BOT_TOKEN=
# NOTIFY_TELEGRAM_CHAT_ID=
# NOTIFY_DISCORD_WEBHOOK=
# NOTIFY_REPORT=report.md          # 推送哪个报告：report.md | eval_report.md

# ===== 人在环审校（HITL）=====
# REVIEW_ENABLE_HITL=false         # 报告前暂停人工确认（交互演示开）
# REVIEW_AUTO_APPROVE=true         # 无人值守自动通过；False = 等待 review_approve.json
# REVIEW_TIMEOUT_SECONDS=0         # HITL 等待超时（秒）；0 = 不限

# ===== 可视化 / 报告（P6：四目标自包含 dashboard + 周报）=====
# VIZ_ENABLE=true                  # VisualizeStage 开关（第 9 阶段）
# VIZ_DASHBOARD_FILE=output/dashboard.html   # 自包含仪表盘（离线可开，明暗主题）
# VIZ_CHARTS_DIR=output/charts     # 单图 SVG 输出目录
# VIZ_TOP_K=20                     # 趋势图/榜单展示 top-N（趋势折线图实际取 min(top_k,6)）
# VIZ_THEME=auto                   # auto(跟随系统) | light | dark
# ===== 生命周期（目标④ S 曲线）=====
# LIFECYCLE_GROWTH_WINDOW=6        # 增速比较窗口（月）
# LIFECYCLE_EMERGING_QUANTILE=0.2  # 累积量分位阈值（判 emerging）
# LIFECYCLE_MIN_HISTORY=12         # 曲线最少箱数，不足标 emerging
# ===== S 曲线选样（专利，承 P4_P3_RESULT §5 待办）=====
# PATENT_CITATION_SAMPLING=stratified   # stratified(分层,默认) | top_total(旧行为,保留对照)
# PATENT_CITATION_N_BINS=5              # 分层箱数（按 log10 总被引）
# PATENT_CITATION_PER_BIN=2000          # 每箱采样上限
# ===== 周报（P6）=====
# WEEKLY_ENABLE=true               # VisualizeStage 周边界生成周报
# WEEKLY_WEEKDAY=0                 # 周一=0（自然边界，实际按 trailing 窗口聚合）
# WEEKLY_WINDOW_DAYS=7             # 聚合最近 N 天 manifest
# WEEKLY_REPORT_FILE=output/weekly_report.md
